{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["patternfly", "playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eval-track.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eval-gate.sh"
          }
        ]
      }
    ]
  }
}
