{
  "name": "@pulp-ui/client",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "clean:all": "rimraf ./dist ./node_modules",
    "build": "vite build",
    "lint": "eslint --max-warnings 0 . && tsc --noEmit -p tsconfig.app.json",
    "lint:fix": "eslint . --fix",
    "lint:fast": "oxlint --type-aware --deny-warnings .",
    "lint:fast:fix": "oxlint --type-aware --deny-warnings --fix .",
    "format": "prettier --check --ignore-path ../.prettierignore './src/**/*.{ts,tsx,js,json}'",
    "format:fix": "prettier --write --ignore-path ../.prettierignore './src/**/*.{ts,tsx,js,json}'",
    "format:fast": "oxfmt --check './src/**/*.{ts,tsx,js,json}'",
    "format:fast:fix": "oxfmt './src/**/*.{ts,tsx,js,json}'",
    "start:dev": "vite --port 3000 --host",
    "start": "vite preview",
    "test": "vitest",
    "generate": "openapi-ts -f ./config/openapi-ts.config.ts && node ./scripts/patch-openapi-client.mjs",
    "coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@patternfly/patternfly": "^6.7.0",
    "@patternfly/react-component-groups": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-data-view": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-styles": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.61.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "axios": "^1.7.2",
    "dayjs": "^1.11.18",
    "oidc-client-ts": "^3.5.0",
    "pretty-bytes": "^7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.84.0",
    "react-oidc-context": "^3.3.1",
    "usehooks-ts": "^3.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.92.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "vite": "^7.1.2",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^4.0.0",
    "vitest-browser-react": "^2.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
