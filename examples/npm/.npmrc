; Everything resolves through the Pulp cache of registry.npmjs.org...
registry=${NPM_PROXY_URL}
; ...except the @example scope, which lives in the hosted repository.
@example:registry=${NPM_HOSTED_URL}
; npm publish credentials for the hosted repository: base64 of user:password.
//${NPM_PUBLISH_HOST_PATH}:_auth=${NPM_AUTH}
