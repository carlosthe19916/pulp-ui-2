<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example.pulp</groupId>
  <artifactId>hello-lib</artifactId>
  <version>${revision}</version>
  <name>Hello library</name>
  <description>A tiny library published to Pulp in the Maven tutorial.</description>

  <properties>
    <!-- Override on the command line: mvn deploy -Drevision=1.0.0 -->
    <revision>1.0.0-SNAPSHOT</revision>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Where mvn deploy uploads. pulp.deploy.url comes from the pulp profile in settings.xml. -->
  <distributionManagement>
    <repository>
      <id>pulp-releases</id>
      <url>${pulp.deploy.url}/maven-releases/</url>
    </repository>
    <snapshotRepository>
      <id>pulp-snapshots</id>
      <url>${pulp.deploy.url}/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.17.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <!-- Writes the resolved version into the deployed pom instead of ${revision}. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
