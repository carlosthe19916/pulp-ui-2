# Copy to .env and adjust. Defaults match the local backend (npm run backend:start).
PULP_URL=http://localhost:5003
# Pulp's API_ROOT (Pulp's default is /pulp/; the local backend uses /api/pulp/).
PULP_API_ROOT=/api/pulp/
# Domain name when Pulp has DOMAIN_ENABLED; leave empty otherwise.
PULP_DOMAIN=default
PULP_USER=admin
PULP_PASSWORD=password
# Where Maven reads from: a distribution's base_url without the base path.
PULP_CONTENT_URL=http://localhost:5003/pulp/content/default
# Where mvn deploy uploads to: /pulp/maven/[<domain>/], followed by the repository name.
PULP_DEPLOY_URL=http://localhost:5003/pulp/maven/default
