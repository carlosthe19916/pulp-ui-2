KEYCLOAK_PORT=8090
KEYCLOAK_REALM=pulp
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_UI_CLIENT_ID=frontend
KEYCLOAK_DEV_USER=admin
KEYCLOAK_DEV_PASSWORD=password

# oauth2-proxy gateway fronting Pulp; the UI's PULP_API_URL points at this host port.
KEYCLOAK_GATEWAY_PORT=5010
# Must decode to 16/24/32 bytes via URL-safe base64 (-/_) -- oauth2-proxy rejects
# standard base64 (+//) as the wrong length. Dev-only; regenerate with:
#   head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
GATEWAY_COOKIE_SECRET=nsAe-d8E1YSIyC9gj2GAwX8Y6aAoAGGY
