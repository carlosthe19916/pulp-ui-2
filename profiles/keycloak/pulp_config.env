# Align admin/exec tooling (pulpcore-manager, generate-client) with the s6 services,
# which hardcode this same path. Auth can't live in a settings file anyway (see below).
PULP_SETTINGS=/etc/pulp/settings.py

# --- Bearer-token API auth (the 401 fix) ---
# Trust the gateway-injected X-Forwarded-Preferred-Username via the shipped
# PulpRemoteUserAuthentication + RemoteUserBackend. Must be PULP_-prefixed env vars, not
# a settings file: the s6 services hardcode /etc/pulp/settings.py, so a profile settings
# file is never loaded -- but dynaconf reads PULP_ vars in every process. dynaconf parses
# "@json"; "__" merges into REST_FRAMEWORK, preserving DEFAULT_PERMISSION_CLASSES / pagination.
PULP_REMOTE_USER_ENVIRON_NAME=HTTP_X_FORWARDED_PREFERRED_USERNAME
PULP_AUTHENTICATION_BACKENDS=@json ["django.contrib.auth.backends.ModelBackend", "pulpcore.backends.ObjectRolePermissionBackend", "django.contrib.auth.backends.RemoteUserBackend"]
PULP_REST_FRAMEWORK__DEFAULT_AUTHENTICATION_CLASSES=@json ["pulpcore.app.authentication.BasicAuthentication", "rest_framework.authentication.SessionAuthentication", "pulpcore.app.authentication.PulpRemoteUserAuthentication"]
