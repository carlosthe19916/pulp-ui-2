{
  "name": "@pulp-ui/root",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "npm run generate --workspaces --if-present",
    "clean": "rimraf ./dist && npm run clean --workspaces --if-present",
    "clean:all": "npm run clean:all --workspaces --if-present && rimraf ./dist ./node_modules",
    "dist": "rimraf ./dist && copyfiles -e 'node_modules/**' entrypoint.sh '**/package.json' '*/dist/**/*' ./dist",
    "lint": "npm run rules:check && npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:fast": "npm run lint:fast --workspaces --if-present",
    "lint:fast:fix": "npm run lint:fast:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:fix": "npm run format:fix --workspaces --if-present",
    "format:fast": "npm run format:fast --workspaces --if-present",
    "format:fast:fix": "npm run format:fast:fix --workspaces --if-present",
    "rules": "rulesync generate",
    "rules:check": "rulesync generate --check",
    "oxlint:sync": "node scripts/oxlint-sync.mjs",
    "build": "npm run build --workspaces --if-present",
    "prepare": "npm run generate && husky",
    "start:dev:common": "npm run start:dev -w common",
    "start:dev:server": "npm run start:dev -w server",
    "start:dev:client": "npm run start:dev -w client",
    "start:dev": "dotenv -c -- npm run build -w common && dotenv -c -- concurrently -n common,server,client -c 'white.bold.inverse,green.bold.inverse,blue.bold.inverse' 'npm:start:dev:common' 'npm:start:dev:server' 'npm:start:dev:client'",
    "start": "dotenv -c -- npm run build -w common -w client && dotenv -c -- npm run start -w server",
    "test": "npm run test -w common -w client -w server --if-present --",
    "test:e2e": "npm run test -w e2e",
    "test:e2e:local": "npm run test:local -w e2e --",
    "backend": "scripts/backend/oci-env.sh",
    "backend:plugins": "scripts/backend/plugins.sh",
    "backend:setup": "scripts/backend/setup.sh",
    "backend:start": "scripts/backend/oci-env.sh compose up",
    "backend:stop": "scripts/backend/oci-env.sh compose down",
    "plugin:new": "npm run plugin:new -w client --",
    "seed": "node scripts/seed-data.mjs"
  },
  "workspaces": [
    "common",
    "client",
    "server",
    "e2e"
  ],
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@oxlint/migrate": "^1.94.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-run": "^3.1.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@rollup/plugin-virtual": "^3.0.3",
    "@tanstack/eslint-plugin-query": "^5.108.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^25.0.3",
    "concurrently": "^10.0.7",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.7",
    "rollup-plugin-copy": "^3.5.0",
    "rulesync": "43.11.0",
    "typescript-eslint": "^8.73.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "scarfSettings": {
    "enabled": false
  }
}
