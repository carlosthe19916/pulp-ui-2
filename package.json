{
  "name": "@pulp-ui/root",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "generate": "npm run generate -ws --if-present",
    "clean": "rimraf ./dist && npm run clean -ws --if-present",
    "clean:all": "npm run clean:all -ws --if-present && rimraf ./dist ./node_modules",
    "dist": "rimraf ./dist && copyfiles -e 'node_modules/**' entrypoint.sh '**/package.json' '*/dist/**/*' ./dist",
    "lint": "npm run rules:check && npm run lint -ws --if-present",
    "lint:fix": "npm run lint:fix -ws --if-present",
    "lint:fast": "npm run lint:fast -ws --if-present",
    "lint:fast:fix": "npm run lint:fast:fix -ws --if-present",
    "format": "npm run format -ws --if-present",
    "format:fix": "npm run format:fix -ws --if-present",
    "format:fast": "npm run format:fast -ws --if-present",
    "format:fast:fix": "npm run format:fast:fix -ws --if-present",
    "rules": "rulesync generate",
    "rules:check": "rulesync generate --check",
    "oxlint:sync": "node scripts/oxlint-sync.mjs",
    "build": "npm run build -ws --if-present",
    "prepare": "npm run generate && husky",
    "start:dev:common": "npm run start:dev -w common",
    "start:dev:server": "npm run start:dev -w server",
    "start:dev:client": "npm run start:dev -w client",
    "start:dev": "dotenv -- npm run build -w common && dotenv -- concurrently -n common,client -c 'white.bold.inverse,green.bold.inverse,blue.bold.inverse' 'npm:start:dev:common' 'npm:start:dev:client'",
    "start": "dotenv -- npm run build -w common -w client && dotenv -- npm run start -w server",
    "test": "npm run test -w common -w client -w server --if-present --",
    "test:e2e": "npm run test -w e2e",
    "test:e2e:local": "npm run test:local -w e2e --",
    "plugin:new": "npm run plugin:new -w client --",
    "seed": "node scripts/seed-data.mjs"
  },
  "workspaces": [
    "common",
    "client",
    "server",
    "e2e"
  ],
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@oxlint/migrate": "^1.89.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-run": "^3.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.54.0",
    "rollup-plugin-copy": "^3.5.0",
    "rulesync": "40.2.0",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
