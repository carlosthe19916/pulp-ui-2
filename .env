PULP_API_ROOT=/api/pulp

## No Auth -> compose.env should enable 'rest_framework.permissions.AllowAny'
# AUTH=none
# PULP_API_URL=http://localhost:5003

## Basic Auth
AUTH=basic
PULP_API_URL=http://localhost:5003

## Keycloak Auth -> compose.env should have 'COMPOSE_PROFILE=pulp-ui-2/keycloak' uncommented
# AUTH=oidc
# PULP_API_URL=http://localhost:5010
