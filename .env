# keycloak profile: target the oauth2-proxy gateway, not Pulp directly (:5003),
# so the UI's Bearer token gets validated.
PULP_API_URL=http://localhost:5010
PULP_API_ROOT=/api/pulp

## No Auth
# AUTH=none

## Basic Auth
# AUTH=basic

## Keycloak Auth -> compose.env should have 'COMPOSE_PROFILE=pulp-ui-2/keycloak' uncommented
AUTH=oidc
