PULP_API_ROOT=/api/pulp

## No Auth -> compose.env should enable 'rest_framework.permissions.AllowAny'
# AUTH=none
# PULP_API_URL=http://localhost:5003

## Basic Auth
AUTH=basic
PULP_API_URL=http://localhost:5003

## Keycloak Auth -> compose.env should have 'COMPOSE_PROFILE=pulp-ui-2/keycloak' uncommented
# AUTH=oidc
# PULP_API_URL=http://localhost:5010

## AI assistant (2.x): off unless AI_PROVIDER and AI_MODEL are set. Copy ONE block below into
## .env.local (git ignores it) and fill it in.
## Never put a key in this file: it is committed.
##
## AI_PROVIDER: openai | anthropic | google | openai-compatible
## AI_MODEL:    the provider's model ID, passed unchanged
## AI_API_KEY:  required, except for openai-compatible (only if the endpoint needs one)
## AI_BASE_URL: required for openai-compatible (with its /v1 path), ignored otherwise

# AI_PROVIDER=openai
# AI_MODEL=<model id, e.g. gpt-6-luna>
# AI_API_KEY=<your OpenAI key>

## OpenAI
# AI_PROVIDER=openai
# AI_MODEL=<model id, e.g. gpt-6-luna>
# AI_API_KEY=<your OpenAI key>

## Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=<model id, e.g. claude-haiku-5-5>
# AI_API_KEY=<your Anthropic key>

## Google Gemini
# AI_PROVIDER=google
# AI_MODEL=<model id, e.g. gemini-3.5-flash>
# AI_API_KEY=<your Google AI key>

## Any OpenAI-compatible endpoint: Ollama, vLLM, OpenRouter, a company gateway...
# AI_PROVIDER=openai-compatible
# AI_MODEL=<model name on that endpoint>
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=<only if the endpoint needs one>
