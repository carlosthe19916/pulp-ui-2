{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@support/*": ["./support/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "playwright.local.ts",
    "tests/**/*.ts",
    "support/**/*.ts"
  ]
}
